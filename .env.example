# Copy to .env and fill in. Placeholders only; never commit real values.

# Public HTTPS origin of this server (no path, no trailing slash).
BASE_URL=https://your-host.example.com

# Oura developer application credentials.
CLIENT_ID=your-oura-client-id
CLIENT_SECRET=your-oura-client-secret
# Must equal <BASE_URL>/auth/callback and be registered in the Oura app.
REDIRECT_URI=https://your-host.example.com/auth/callback

# Credentials you type into the Claude connector form.
MCP_CLIENT_ID=oura-mcp
# Generate with: openssl rand -hex 32
MCP_CLIENT_SECRET=replace-with-generated-secret
# Optional; defaults to Claude's fixed callback URL.
# MCP_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback

# Supabase project (token storage).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-key

# Optional; host port used by docker compose (default 8000).
# PORT=8000

# Optional; host interface for the compose port (default 0.0.0.0). Use 127.0.0.1
# behind a same-host proxy, or a LAN address for LAN-only access.
# BIND_ADDR=192.0.2.10

# Optional; local image tag used by docker compose (default latest).
# IMAGE_TAG=latest
